{%- if blog.articles.size > 0 -%}
  {%- assign limit = section.settings.max_articles | default: 5 -%}

  <div
    id="BlogSlider-{{ section.id }}"
    class="blog-slider-section"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 | default: 5000 }}"
  >
    <div class="blog-slider__track">
      {%- for article in blog.articles limit: limit -%}
        {%- liquid
          assign loading = 'lazy'
          assign fetchpriority = 'low'
          if forloop.first
            assign loading = 'eager'
            assign fetchpriority = 'high'
          endif
        -%}
        <div
          class="blog-slider__slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
        >
          <div class="blog-slider__image-wrapper">
            {%- if article.image -%}
              {{
                article.image
                | image_url: width: 2000
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'blog-slider__image',
                  widths: '600, 1000, 1500, 2000'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'blog-slider__image placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="blog-slider__content-container container mx-auto px-4">
            <div class="blog-slider__text-card">
              {%- if article.tags.size > 0 -%}
                <span class="blog-slider__tag">
                  in {{ article.tags.first }}
                </span>
              {%- endif -%}
              <h2 class="blog-slider__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if blog.articles.size > 1 -%}
      <button
        class="blog-slider__arrow blog-slider__arrow--prev"
        aria-label="Previous Slide"
        type="button"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-left">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="blog-slider__arrow blog-slider__arrow--next"
        aria-label="Next Slide"
        type="button"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-right">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="blog-slider__dots" role="tablist" aria-label="Slider Pagination">
        {%- for article in blog.articles limit: limit -%}
          <button
            role="tab"
            class="blog-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            type="button"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <style>
    #BlogSlider-{{ section.id }} {
      position: relative;
      width: 100%;
      height: {{ section.settings.height_desktop }}vh;
      min-height: 400px;
      overflow: hidden;
      background-color: #000;
      color: #fff;
    }

    @media screen and (max-width: 749px) {
      #BlogSlider-{{ section.id }} {
        height: {{ section.settings.height_mobile }}vh;
        min-height: 300px;
      }
    }

    .blog-slider__track {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .blog-slider__slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.8s;
      z-index: 1;
    }

    .blog-slider__slide.is-active {
      opacity: 1;
      visibility: visible;
      z-index: 2;
    }

    .blog-slider__image-wrapper {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .blog-slider__image-wrapper::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.1) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        rgba(0, 0, 0, 0.85) 100%
      );
      z-index: 2;
    }

    .blog-slider__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .blog-slider__content-container {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      padding-bottom: 70px;
      z-index: 3;
    }

    .blog-slider__text-card {
      max-width: 700px;
      text-align: left;
    }

    .blog-slider__tag {
      display: inline-block;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 12px;
      background: rgba(255, 255, 255, 0.12);
      padding: 4px 12px;
      border-radius: 4px;
      backdrop-filter: blur(4px);
    }

    .blog-slider__title {
      font-size: clamp(24px, 4vw, 42px);
      line-height: 1.2;
      font-weight: 700;
      margin: 0;
    }

    .blog-slider__title a {
      color: #fff;
      text-decoration: none;
      transition: opacity 0.3s ease;
    }

    .blog-slider__title a:hover {
      opacity: 0.85;
    }

    .blog-slider__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 48px;
      height: 48px;
      border: none;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: background 0.3s ease, transform 0.3s ease;
      backdrop-filter: blur(4px);
    }

    .blog-slider__arrow:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: translateY(-50%) scale(1.05);
    }

    .blog-slider__arrow svg {
      width: 24px;
      height: 24px;
    }

    .blog-slider__arrow--prev {
      left: 24px;
    }

    .blog-slider__arrow--next {
      right: 24px;
    }

    .blog-slider__dots {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      gap: 8px;
    }

    .blog-slider__dot {
      width: 8px;
      height: 8px;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      padding: 0;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .blog-slider__dot.is-active {
      width: 24px;
      border-radius: 4px;
      background: #fff;
    }

    @media screen and (max-width: 749px) {
      .blog-slider__arrow {
        width: 38px;
        height: 38px;
      }
      .blog-slider__arrow--prev {
        left: 12px;
      }
      .blog-slider__arrow--next {
        right: 12px;
      }
      .blog-slider__arrow svg {
        width: 18px;
        height: 18px;
      }
      .blog-slider__content-container {
        padding-bottom: 50px;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      initBlogSlider();
    });

    // Theme Customizer live preview support
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initBlogSlider();
      }
    });

    function initBlogSlider() {
      const slider = document.getElementById('BlogSlider-{{ section.id }}');
      if (!slider) return;

      const slides = [...slider.querySelectorAll('.blog-slider__slide')];
      const dots = [...slider.querySelectorAll('.blog-slider__dot')];
      const prevBtn = slider.querySelector('.blog-slider__arrow--prev');
      const nextBtn = slider.querySelector('.blog-slider__arrow--next');

      let currentIndex = 0;
      let autoplayTimer = null;
      const autoplayEnabled = slider.dataset.autoplay === 'true';
      const autoplaySpeed = parseInt(slider.dataset.autoplaySpeed, 10) || 5000;

      if (slides.length <= 1) return;

      function goToSlide(index) {
        slides[currentIndex].classList.remove('is-active');
        if (dots.length) dots[currentIndex].classList.remove('is-active');

        currentIndex = (index + slides.length) % slides.length;

        slides[currentIndex].classList.add('is-active');
        if (dots.length) {
          dots[currentIndex].classList.add('is-active');
          dots[currentIndex].setAttribute('aria-selected', 'true');
        }

        resetAutoplay();
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      if (prevBtn) prevBtn.addEventListener('click', prevSlide);
      if (nextBtn) nextBtn.addEventListener('click', nextSlide);

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => goToSlide(index));
      });

      // Swipe Support
      let touchStartX = 0;
      let touchEndX = 0;

      slider.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      slider.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });

      function handleSwipe() {
        if (touchStartX - touchEndX > 50) {
          nextSlide();
        } else if (touchEndX - touchStartX > 50) {
          prevSlide();
        }
      }

      function startAutoplay() {
        if (!autoplayEnabled) return;
        stopAutoplay();
        autoplayTimer = setInterval(nextSlide, autoplaySpeed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      startAutoplay();

      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Blog Hero Slider",
  "tag": "section",
  "class": "blog-hero-slider-section",
  "settings": [
    {
      "type": "range",
      "id": "max_articles",
      "label": "Max articles to display",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Slider height (desktop - vh)",
      "min": 40,
      "max": 90,
      "step": 5,
      "default": 65
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Slider height (mobile - vh)",
      "min": 30,
      "max": 80,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Blog Hero Slider"
    }
  ]
}
{% endschema %}
