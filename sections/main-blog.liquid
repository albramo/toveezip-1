{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign posts_per_page = section.settings.posts_per_page | default: 9
%}

<div class="main-blog-container section {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}">
  <div class="container mx-auto px-4">

    <div class="blog-header-section">
      <h1 class="blog-title">{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by posts_per_page -%}
      <div class="blog-grid" data-testid="blog-posts">
        {%- for article in blog.articles -%}
          <article class="blog-card" data-testid="blog-post-item">
            <a href="{{ article.url }}" class="blog-card__image-link" aria-label="{{ article.title | escape }}">
              <div class="blog-card__image-wrapper">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'blog-card__image',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      widths: '375, 550, 750, 1100, 1500'
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'blog-card__image placeholder-svg' }}
                {%- endif -%}
              </div>
            </a>

            <div class="blog-card__content">
              <div class="blog-card__meta">
                <span class="blog-card__blog-title">{{ blog.title }}</span>
                <span class="blog-card__separator">•</span>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="blog-card__date">
                  {{ article.published_at | time_tag: format: 'date' }}
                </time>
              </div>

              <h2 class="blog-card__title">
                <a href="{{ article.url }}" class="blog-card__title-link">
                  {{ article.title }}
                </a>
              </h2>

              <p class="blog-card__excerpt">
                {%- if article.excerpt != blank -%}
                  {{ article.excerpt | strip_html | truncatewords: 25 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 25 }}
                {%- endif -%}
              </p>

              <div class="blog-card__footer">
                <a href="{{ article.url }}" class="blog-card__read-more-btn">
                  {{ 'content.read_more' | t | default: 'Read More' }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="blog-pagination-wrapper">
          {%- render 'pagination-controls', paginate: paginate -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

<style>
  .main-blog-container {
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
    background-color: var(--color-background, #ffffff);
    color: var(--color-foreground, #000000);
  }

  .blog-header-section {
    text-align: center;
    margin-bottom: 48px;
  }

  .blog-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-foreground, #000000);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    width: 100%;
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform var(--hover-transition-duration, 0.3s) var(--hover-transition-timing, ease),
                box-shadow var(--hover-transition-duration, 0.3s) var(--hover-transition-timing, ease);
    height: 100%;
  }

  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .blog-card__image-link {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: 60%; /* Beautiful aspect ratio */
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .blog-card__image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.05);
  }

  .blog-card__content {
    display: flex;
    flex-direction: column;
    padding: 24px;
    flex-grow: 1;
    text-align: left;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-foreground-muted, #757575);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-card__blog-title {
    color: var(--color-foreground, #000000);
    font-weight: 600;
  }

  .blog-card__separator {
    color: rgba(0, 0, 0, 0.25);
  }

  .blog-card__title {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  .blog-card__title-link {
    color: var(--color-foreground, #000000);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card__title-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .blog-card__title-link:hover {
    color: var(--color-foreground-muted, #757575);
  }

  .blog-card__excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-foreground-muted, #555555);
    margin: 0 0 20px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .blog-card__read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-foreground, #000000);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .blog-card__read-more-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .blog-card__read-more-btn:hover {
    color: var(--color-foreground-muted, #555555);
    gap: 12px;
  }

  .blog-card__read-more-btn:hover svg {
    transform: translateX(2px);
  }

  .blog-pagination-wrapper {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .blog-header-section {
      margin-bottom: 32px;
    }
    .blog-card__content {
      padding: 20px;
    }
    .blog-card__excerpt {
      margin-bottom: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Main Blog Listing",
  "tag": "section",
  "class": "main-blog-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts Per Page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}